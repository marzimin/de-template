# Secrets and machine-specific paths. Copy with: cp .env.example .env
# Everything that is not a secret belongs in cfg/config.yaml, which is tracked.

# ── Postgres server ────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres

# ── Warehouse database ─────────────────────────
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=de_user
WAREHOUSE_PASSWORD=de_password

# ── Airflow ────────────────────────────────────
AIRFLOW_UID=50000

# ── Container image versions ───────────────────
# The one place to bump when Postgres or Airflow ships a new version —
# docker-compose.yml reads both for the image tag / build arg, so nothing
# else needs editing. Not secrets; the defaults here are what's actually
# tested. See docs/operations.md "Upgrading the pinned versions" before
# bumping either, especially POSTGRES_VERSION if postgres_data already holds
# data you care about.
POSTGRES_VERSION=17
AIRFLOW_VERSION=3.3.1

# ── Hand-off to ds-template ──────────────
# Where `make export` writes the mart files. Unset, exports land in
# cfg/config.yaml's `exports.destination` (data/exports/) and you copy them
# across yourself. Set it to the DS project's data/raw/ to skip the copy —
# the usual setup when both repositories are checked out side by side.
#
# HANDOFF_DESTINATION_DIR=/Users/you/code/ds-template/data/raw

# Overrides the repository root used to resolve cfg/, dbt/ and data/.
# Normally left unset — it is inferred from the core package location.
# DE_PROJECT_ROOT=/opt/airflow

# ── API Keys (add your sources here) ───────────
# Placeholder for the bundled example extractor. The example DAG's task will
# fail until you point the extractor at a real API and supply a real key —
# that is expected. Replace or remove when you add your own sources.
EXAMPLE_API_KEY=replace_me

# The local_* sources (extractors/files/local_excel.py) need nothing here —
# they read data/sample_source/, configured in cfg/config.yaml's
# `local_dummy_data` section since a local path is not a secret. Run
# `make local-seed` to populate it.
