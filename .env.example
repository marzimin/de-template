# ── Postgres server ────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres

# ── Warehouse database ─────────────────────────
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=de_user
WAREHOUSE_PASSWORD=de_password

# ── Airflow ────────────────────────────────────
AIRFLOW_UID=50000

# ── API Keys (add your sources here) ───────────
