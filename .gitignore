# --- OS cruft (macOS) ---
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/
env.bak/
venv.bak/

# --- Claude ---
.claude/

# --- Packaging / build artefacts ---
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
*.whl
*.manifest
*.spec

# --- Logs & runtime files ---
*.log
logs/
coverage.xml
htmlcov/
.coverage
.coverage.*
.cache/

# --- Test reports ---
test-output.xml

# --- Tools / IDEs ---
.idea/
.cursorignore
.cursorindexingignore
# Ignore .vscode contents but keep the two files that carry real project
# knowledge: the interpreter path and the recommended extensions. This must use
# .vscode/* rather than .vscode/ — git does not descend into an excluded
# directory, so a negation inside one never applies.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*~
*.swp
*.swo

# --- Pre-commit (caches) ---
.pre-commit*
!.pre-commit-config.yaml

# --- Environment & secrets ---
.env
.env.*
.envrc
!.env.example

# --- dbt ---
dbt/.user.yml
dbt/target/
dbt/dbt_packages/
dbt/logs/

# --- Airflow (local runtime state, if you run it outside Docker) ---
airflow.db
airflow-webserver.pid
airflow.cfg
standalone_admin_password.txt

# --- Data ---
# Anchored with a leading slash so they match only at the repository root.
# Unanchored, `data/` would also match any nested directory of that name and
# silently ignore source files.
# /data/exports/ — where exporters/ writes the hand-off files consumed by
#                  ds-template-local. Track the structure, never the contents.
/data/**
!/data/exports/
!/data/exports/.gitkeep

# --- Notebooks (keep structure, ignore contents except tracked files) ---
notebooks/**
!notebooks/.gitkeep
!notebooks/scrapbook.py

# --- Local databases ---
*.sqlite
*.sqlite3
*.db
*.db-journal
